# ==============================================================================
# Bestlink College of the Philippines — Attendance Monitoring System (AMS)
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do not commit actual secrets to version control)
# 2. Fill in the values for your active Supabase project and SMS gateway
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public / Safe for Browser)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Server & Edge Functions (Private / Never expose to Frontend)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. SMS Alert Gateway (Parent Notifications - Semaphore / Movider)
# ------------------------------------------------------------------------------
SMS_GATEWAY_PROVIDER=semaphore
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=BCP-AMS

# ------------------------------------------------------------------------------
# 4. Hardware Gate Ingress (ESP32 RFID & Fallback QR Ingestion)
# ------------------------------------------------------------------------------
SCAN_INGEST_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/scan-ingest
DEVICE_SECRET_SALT=replace_with_cryptographic_hardware_salt_32chars

# ------------------------------------------------------------------------------
# 5. Core Attendance Business Rules (Defaults)
# ------------------------------------------------------------------------------
# Anti-passback cooldown window in minutes (Strict minimum: 5)
ANTI_PASSBACK_COOLDOWN_MINUTES=5

# Grace period before marking arrival as Tardy (in minutes)
TARDINESS_GRACE_PERIOD_MINUTES=15
